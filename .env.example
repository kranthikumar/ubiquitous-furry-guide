# Copy to .env.local (git-ignored) and fill in. On Vercel, add the same
# variables under Project → Settings → Environment Variables.

# App connection: Supabase transaction-mode pooler (port 6543).
# Supabase dashboard → Connect → ORMs → Drizzle.
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@<region>.pooler.supabase.com:6543/postgres"

# Migrations and seeding: session-mode pooler or direct connection (port 5432).
# Optional; falls back to DATABASE_URL.
DIRECT_URL="postgresql://postgres.<project-ref>:<password>@<region>.pooler.supabase.com:5432/postgres"
